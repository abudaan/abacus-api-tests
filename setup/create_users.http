@base = http://localhost:8080

### create admin
POST {{base}}/api/initialise/first-admin
Content-Type: application/json

{
  "fullname": "Bernard Braam",
  "temp_password": "Temp01Password",
  "username": "admin"
}

### admin login 
POST {{base}}/api/login
Content-Type: application/json

{
    "username": "admin",
    "password": "Temp01Password"
}


### create coordinator_gsb
POST {{base}}/api/users
Content-Type: application/json

{
  "fullname": "Cor de Man",
  "role": "coordinator_gsb",
  "temp_password": "Coordinator01Password01",
  "username": "coord1"
}


